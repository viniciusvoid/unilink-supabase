# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase
# (Dashboard > Project Settings > API)

# URL do projeto (a mesma usada no front, em js/supabaseConfig.js)
SUPABASE_URL=https://lylnrlybiyfoogfsnctz.supabase.co

# ATENÇÃO: esta é a chave SECRETA (service_role). Ela ignora RLS.
# NUNCA coloque essa chave no front-end, no git público, ou em
# qualquer lugar visível ao navegador. Ela só deve existir aqui,
# no servidor, e no seu provedor de hospedagem (variável de ambiente).
# Obtenha em: Supabase Dashboard → Project Settings → API → service_role (eyJ...)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_JWT_HERE

# Porta em que a API vai rodar localmente
PORT=3001

# Senha padrão inicial foi removida (sem senha compartilhada).
# O administrador define a senha inicial ao criar/resetar usuário.
# ADMIN_SENHA_PADRAO= (não utilizado)

# Origem(ns) autorizada(s) a chamar esta API (CORS). Obrigatório em produção.
# Localhost/127.0.0.1 sempre liberados para desenvolvimento.
CORS_ORIGIN=https://unilinkmnt-production.up.railway.app
